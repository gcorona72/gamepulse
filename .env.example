# Copia este fichero a .env y rellena tus credenciales. .env nunca se sube a Git.

# Twitch: https://dev.twitch.tv/console/apps (tipo de cliente: Confidencial)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam: https://steamcommunity.com/dev/apikey (no hace falta para jugadores simultáneos, sí para otros endpoints)
STEAM_API_KEY=

# Infraestructura local (valores por defecto de docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
LAKEHOUSE_BUCKET=lakehouse

# Ingesta
TWITCH_TOP_GAMES=50
TWITCH_POLL_SECONDS=60
STEAM_POLL_SECONDS=3600
